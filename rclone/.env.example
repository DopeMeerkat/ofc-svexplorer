# Copy to rclone/.env (gitignored) and fill in server-specific values.

# Case studies are local-only now: they live in the committed case_studies/
# folder and are NOT refreshed from OneDrive. You may override the folder with:
# CASE_STUDY_CACHE_DIR=/path/to/web_igv/case_studies

# Used only by scripts/convert_case_study_docx.py as the default for its
# optional --remote manual-backup upload:
# CASE_STUDY_RCLONE_BIN=/path/to/rclone
# CASE_STUDY_RCLONE_REMOTE=uconn:OneDrive/folder/Data/Case_Study

# PATHWAY_RCLONE_BIN=/path/to/rclone   (defaults to CASE_STUDY_RCLONE_BIN)
# PATHWAY_RCLONE_REMOTE=uconn:OneDrive/folder/Data/Pathway
# PATHWAY_CACHE_DIR=/path/to/web_igv/rclone/cache/pathway_networks
# PATHWAY_REFRESH_TIMEOUT_SECONDS=120
